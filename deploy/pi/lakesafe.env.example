# Copy to /etc/lakesafe/drone.env (root:root, 0644). No secrets here: the key is a separate 0600 file.
LAKESAFE_API=http://192.168.137.1:8000
LAKESAFE_DRONE_ID=00000000-0000-0000-0000-000000000000
LAKESAFE_KEY=/etc/lakesafe/drone.pem
# MAVLink system id of this aircraft (SYSID_THISMAV) and the TELEM port the Pi is wired to.
LAKESAFE_SYSID=1
LAKESAFE_MAVLINK=/dev/serial0
LAKESAFE_BAUD=57600
# YOLO thermal weights; leave empty for the model-free hot-spot detector (no ultralytics needed).
LAKESAFE_MODEL=
# Demo footage: the thermal view (boxed detections) and the Pi CSI camera both record here.
# Empty turns thermal recording off; lakesafe-camera.service needs it set.
LAKESAFE_RECORD=/home/pi/footage
# Extra pi_camera_record flags, e.g. --hflip --vflip for an upside-down camera, --size 1920x1080.
LAKESAFE_CAMERA_ARGS=
