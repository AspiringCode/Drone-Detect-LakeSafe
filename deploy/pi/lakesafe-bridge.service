[Unit]
Description=LakeSafe MAVLink bridge (position, battery, mode -> signed heartbeats)
# Signed requests fail a 30 s clock-skew check, and the Pi has no battery clock: wait for NTP.
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target time-sync.target

[Service]
User=pi
EnvironmentFile=/etc/lakesafe/drone.env
WorkingDirectory=/home/pi/Drone-Detect-LakeSafe/backend
RuntimeDirectory=lakesafe
RuntimeDirectoryPreserve=yes
ExecStart=/home/pi/Drone-Detect-LakeSafe/backend/.venv/bin/python -m app.devices.mavlink_bridge \
  --api ${LAKESAFE_API} --mavlink ${LAKESAFE_MAVLINK} --baud ${LAKESAFE_BAUD} \
  --drone ${LAKESAFE_SYSID}=${LAKESAFE_DRONE_ID}=${LAKESAFE_KEY} --position-file /run/lakesafe/position.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
